{
	"$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
	"name": "Guardian Pulse",
	"version": "2025.10",
	"sets": {
		"base": {
			"sources": [
				{
					"$ref": "./src/tokens/base/base.json"
				}
			]
		}
	},
	"modifiers": {
		"brand": {
			"contexts": {
				"core": [{ "$ref": "./src/tokens/brand/core.json" }],
				"news": [{ "$ref": "./src/tokens/brand/news.json" }]
			},
			"default": "core"
		},
		"mode": {
			"contexts": {
				"light": [{ "$ref": "./src/tokens/mode/light.json" }],
				"dark": [{ "$ref": "./src/tokens/mode/dark.json" }]
			},
			"default": "light"
		}
	},
	"resolutionOrder": [
		{
			"$ref": "#/sets/base"
		},
		{
			"$ref": "#/modifiers/brand"
		},
		{
			"$ref": "#/modifiers/mode"
		}
	]
}
