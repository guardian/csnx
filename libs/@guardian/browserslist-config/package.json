{
	"name": "@guardian/browserslist-config",
	"version": "8.0.0",
	"description": "Browserslist config for Guardian websites",
	"repository": {
		"url": "https://github.com/guardian/csnx",
		"directory": "libs/@guardian/browserslist-config"
	},
	"main": "browserslist.js",
	"files": [
		".browserslistrc",
		"browserslist-stats.json"
	],
	"scripts": {
		"fix": "wireit",
		"lint": "wireit",
		"tsc": "wireit",
		"update-readme": "node ./scripts/update-readme.mjs"
	},
	"wireit": {
		"fix": {
			"command": "eslint --cache --color . --fix",
			"files": [
				"**",
				"!.eslintcache"
			],
			"output": [
				"."
			],
			"clean": false
		},
		"lint": {
			"command": "eslint --cache --color .",
			"files": [
				"**",
				"!.eslintcache"
			],
			"output": []
		},
		"tsc": {
			"command": "tsc --pretty",
			"files": [
				"**",
				"tsconfig.json",
				"../tsconfig/tsconfig.json",
				"../../../@types/**",
				"../../../tsconfig.base.json",
				"!(dist)/**",
				"!.eslintcache"
			],
			"output": []
		}
	},
	"devDependencies": {
		"@guardian/browserslist-config": "workspace:*",
		"@guardian/eslint-config": "workspace:*",
		"browserslist": "4.28.9",
		"eslint": "9.39.1",
		"tslib": "2.8.1",
		"wireit": "0.14.13"
	},
	"peerDependencies": {
		"browserslist": "^4.28.9",
		"tslib": "^2.8.1"
	},
	"publishConfig": {
		"access": "public"
	}
}
